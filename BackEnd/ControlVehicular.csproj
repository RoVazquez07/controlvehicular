<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ControlVehicular</RootNamespace>
    <AssemblyName>ControlVehicular</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a1f3c8e2-9b44-4d71-8e5a-2c7f91b0d6a4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ControlVehicular.Tests\**" />
    <Content Remove="ControlVehicular.Tests\**" />
    <None Remove="ControlVehicular.Tests\**" />
    <EmbeddedResource Remove="ControlVehicular.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Scripts\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
